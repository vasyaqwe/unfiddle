{
   "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
   "formatter": {
      "enabled": true,
      "formatWithErrors": false,
      "indentStyle": "space",
      "indentWidth": 3,
      "lineEnding": "lf",
      "lineWidth": 80,
      "attributePosition": "multiline"
   },
   "files": {
      "includes": [
         "**",
         "!**/dist",
         "!**/out",
         "!**/.turbo",
         "!**/.astro",
         "!**/*.astro",
         "!**/routeTree.gen.ts",
         "!**/migrations/meta",
         "!**/package.json",
         "!**/.wrangler",
         "!**/.tanstack"
      ]
   },
   "css": {
      "parser": {
         "tailwindDirectives": true
      },
      "formatter": {
         "enabled": true
      }
   },
   "javascript": {
      "formatter": {
         "jsxQuoteStyle": "double",
         "trailingCommas": "all",
         "semicolons": "asNeeded",
         "arrowParentheses": "always",
         "bracketSpacing": true,
         "bracketSameLine": false,
         "quoteStyle": "double",
         "attributePosition": "multiline"
      }
   },
   "assist": { "actions": { "source": { "organizeImports": "on" } } },
   "overrides": [
      {
         "includes": [
            "**/*.test.ts",
            "**/*.test.tsx",
            "**/tests/**",
            "**/__mocks__/**"
         ],
         "linter": {
            "rules": {
               "suspicious": {
                  "noExplicitAny": "off",
                  "noExtraNonNullAssertion": "off"
               },
               "style": {
                  "noNonNullAssertion": "off"
               }
            }
         }
      }
   ],
   "linter": {
      "enabled": true,
      "rules": {
         "preset": "recommended",
         "security": {
            "noDangerouslySetInnerHtml": "off"
         },
         "complexity": {
            "noImportantStyles": "off"
         },
         "style": {
            "noDescendingSpecificity": "off",
            "useNumberNamespace": "off",
            "noUnusedTemplateLiteral": "off",
            "useNodejsImportProtocol": "off"
         },
         "correctness": {
            "useParseIntRadix": "off",
            "useHookAtTopLevel": "off",
            "useExhaustiveDependencies": "off",
            "noUnusedVariables": "error",
            "noUnusedImports": "error"
         },
         "a11y": {
            "noStaticElementInteractions": "off",
            "noAutofocus": "off",
            "useMediaCaption": "off",
            "noSvgWithoutTitle": "off",
            "useKeyWithClickEvents": "off",
            "useButtonType": "off"
         },
         "suspicious": {
            "noArrayIndexKey": "off"
         },
         "nursery": {
            "useSortedClasses": {
               "level": "info",
               "fix": "safe",
               "options": {
                  "attributes": ["className", "tw"],
                  "functions": ["clsx", "cva", "tw", "cn"]
               }
            }
         }
      }
   }
}
